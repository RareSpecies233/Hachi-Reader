# Hachi Reader — 环境变量示例
#
# 用法（systemd）：
#   sudo install -m 0640 -o root -g hachi deploy/hachi.env.example /etc/hachi/hachi.env
#   sudo systemctl restart hachi
#
# 用法（systemd 之外，例如手动 / launchd）：
#   set -a; . ./deploy/hachi.env.example; set +a; ./hachi

# 监听地址。默认只监听本机，交给 Caddy 反代成 HTTPS：
HACHI_ADDR=127.0.0.1:8080
# 想直接给局域网访问就改成：
# HACHI_ADDR=:8080

# 数据目录：SQLite、抓取缓存、图片落盘都放这里
HACHI_DATA=/var/lib/hachi

# 可选：单用户鉴权 token。设置后客户端需带 Authorization: Bearer <token>
# 或 ?token=<token>；留空则不校验（只建议在可信内网）。
# HACHI_TOKEN=change-me-to-a-long-random-string

# 时区影响统计里的「今天」
TZ=Asia/Shanghai

# 可选：wenku8 账号（按服务端实际支持的变量名调整）
# HACHI_WENKU8_USER=your-account
# HACHI_WENKU8_PASS=your-password
